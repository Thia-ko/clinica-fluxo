generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexão normal (pode passar por pooler, como no Neon)
  directUrl = env("DIRECT_URL") // conexão direta, usada pelas migrações
}

enum TicketType {
  NORMAL
  PRIORITY
}

enum Stage {
  WAITING_RECEPTION
  WAITING_TRIAGE
  IN_TRIAGE
  WAITING_CONSULT
  IN_CONSULT
  DONE
  NO_SHOW // chamado, mas não compareceu
}

// Uma senha tirada no totem. Acompanha o paciente por toda a clínica.
model Ticket {
  id             Int           @id @default(autoincrement())
  code           String        // ex.: N003 (normal) ou P001 (prioritária)
  type           TicketType    @default(NORMAL)
  stage          Stage         @default(WAITING_RECEPTION)
  room           String?       // sala/guichê da última chamada
  stageEnteredAt DateTime      @default(now())
  createdAt      DateTime      @default(now())
  events         TicketEvent[]
  // Link secreto da pesquisa de satisfação (vai no QR code da senha)
  feedbackToken  String?       @unique
  feedback       Feedback?

  @@index([stage])
  @@index([createdAt])
}

// Histórico: cada mudança de etapa vira um registro com horário.
// É daqui que sai o cálculo de tempo de espera por etapa.
model TicketEvent {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  stage     Stage
  room      String?
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// Cargos da clínica. O ADMIN (RH/T.I.) cria usuários e define o cargo de cada um.
enum Role {
  ADMIN
  RECEPTION
  NURSE
  DOCTOR
  MANAGER
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String // nunca a senha em si: só o hash (scrypt)
  role         Role
  active       Boolean   @default(true)
  // Senha provisória (criada ou redefinida pelo Admin): a pessoa precisa trocá-la no próximo acesso.
  mustChangePassword Boolean @default(false)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

// Sessão de login. Guardamos só o hash do token; o token de verdade fica no cookie.
model Session {
  id        String   @id // sha256 do token do cookie
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String? // navegador/aparelho, só para a pessoa reconhecer suas sessões

  @@index([userId])
}

// O que mais incomodou o paciente (várias respostas possíveis).
enum FeedbackReason {
  WAIT_RECEPTION
  WAIT_TRIAGE
  WAIT_CONSULT
  STAFF
  COMFORT
  SIGNAGE
  OTHER
}

// Pesquisa de satisfação: uma por senha, sem nenhum dado pessoal do paciente.
model Feedback {
  id        Int              @id @default(autoincrement())
  ticketId  Int              @unique
  ticket    Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  rating    Int // 1 a 5
  comment   String?
  reasons   FeedbackReasonOnFeedback[]
  createdAt DateTime         @default(now())

  @@index([createdAt])
}

model FeedbackReasonOnFeedback {
  feedbackId Int
  feedback   Feedback       @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  reason     FeedbackReason

  @@id([feedbackId, reason])
}

// Tentativas de login que falharam. Ficam no banco (e não na memória do servidor)
// porque na nuvem cada requisição pode cair numa instância diferente.
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String
  ip        String? // permite limitar também por origem, e não só por e-mail
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}
